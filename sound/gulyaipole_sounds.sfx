#
#  Файл озвучки: voice.ogg (сконвертировано из voice.mp3)
#  Расположение: sound/voice.ogg — движок ищет относительно папки sound/
#  Воспроизведение: автоматически при открытии окна
#  gulyaipole_cinematic_intro_window (show_sound)
# =============================================================================

# -------------------------------------------------------------------------
# Основная озвучка вступления — эпический текст Гуляй-Поля
# -------------------------------------------------------------------------
gulyaipole_intro_voiceover = {
    file = "voice.ogg"
    volume = 1.0
    is_3d = no
    # priority = 100 — высокий приоритет для интро
}

# Алиас для совместимости с событием новостей (если используется через sound)
gulyaipole_intro_voice = {
    file = "voice.ogg"
    volume = 0.95
    is_3d = no
}

# Резервный вариант — если файл в music/ (некоторые сборки)
gulyaipole_intro_music_voice = {
    file = "voice.ogg"
    volume = 1.0
    is_3d = no
}
