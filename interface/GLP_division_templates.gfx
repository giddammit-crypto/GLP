# =========================================================================
#  GLP -- Иконки шаблонов дивизий: знамёна добровольцев (90/91)
#         и конница РПА (92)   (v1.5.1)
#
#  Механика: division_template с template_counter = N берёт спрайты
#  GFX_div_templ_N_large (76x42, дизайнер дивизий / детальная панель)
#  и GFX_div_templ_N_small (30x12, контр-фишки на карте).
#  Официальная документация: hoi4.paradoxwikis.com/Division_modding.
#
#  90 -- Белогвардейские добровольцы: чёрный флаг Батьки Махно с черепом
#        и костями + бело-сине-красная полоса у древка (фокус
#        GLP_old_enemies_unite, шаблоны «Офицерская добровольческая
#        дивизия» / «Казачья добровольческая конная дивизия»).
#  91 -- Испанские анархисты CNT-FAI: красно-чёрная диагональ с черепом
#        (фокус GLP_aid_to_spanish_anarchists и событие glp_spain.1,
#        шаблоны «Интернациональная бригада CNT-FAI» / «Испанская
#        ударная конная колонна»).
#  92 -- КОННИЦА: силуэт кавалерии базовой игры, а НЕ своя картинка. Counter
#        обязателен: без явного counter движок берёт иконку под-юнита с
#        наибольшим priority в составе (у конных дивизий с Pz.39-бронетехникой
#        это мог быть лёгкий танк). Свою плитку под этот номер мы не рисуем:
#        взяты спрайты из самой игры
#        (gfx/interface/counters/divisions_{large,small}/unit_cavalry_icon.dds,
#        объявление скопировано из ванильного interface/subuniticons.gfx,
#        включая noOfFrames = 2 -- атлас из двух кадров).
#  93/94 -- ТАЧАНКИ РПА (собственные плитки 76x42/30x12): стартовый
#        «Ударный тачаночный курень» (93, пулемётная тачанка) и
#        «Бронированный тачаночный курень» (94, бронированная тачанка).
#        Объявлены в interface/GLP_subunit_icons.gfx вместе с иконками
#        под-юнитов GFX_unit_tachanka_* / GFX_unit_armored_tachanka_*.
#        Таблица шаблонов и их иконок: tools/division_icons.tsv, сверяет
#        tools/glp_audit.py (check_division_icons).
# =========================================================================

spriteTypes = {

	### Большие знамёна (дизайнер дивизий, 76x42) ###

	spriteType = {
		name = "GFX_div_templ_90_large"
		texturefile = "gfx/interface/counters/division_templates_large/GLP_white_volunteers.dds"
	}
	spriteType = {
		name = "GFX_div_templ_91_large"
		texturefile = "gfx/interface/counters/division_templates_large/GLP_spanish_volunteers.dds"
	}
	spriteType = {
		name = "GFX_div_templ_92_large"
		texturefile = "gfx/interface/counters/divisions_large/unit_cavalry_icon.dds"
		noOfFrames = 2
	}

	
	### Малые знамёна (контр-фишки на карте, 30x12) ###

	spriteType = {
		name = "GFX_div_templ_90_small"
		texturefile = "gfx/interface/counters/division_templates_small/GLP_white_volunteers.dds"
	}
	spriteType = {
		name = "GFX_div_templ_91_small"
		texturefile = "gfx/interface/counters/division_templates_small/GLP_spanish_volunteers.dds"
	}
	spriteType = {
		name = "GFX_div_templ_92_small"
		texturefile = "gfx/interface/counters/divisions_small/onmap_unit_cavalry_icon.dds"
		noOfFrames = 2
	}
}
