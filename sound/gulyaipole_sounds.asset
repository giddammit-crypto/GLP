# =============================================================================
#  ГУЛЯЙ-ПОЛЕ — звуковая регистрация (HOI4 v1.19.2)
#  Автор: Амброзиев О.А.
#  AAA Photorealistic & PDX Technical Guidelines Compliance
#
#  Файл озвучки: voice.ogg (сконвертировано из voice.mp3)
#  Расположение: sound/voice.ogg — движок ищет относительно папки sound/
#  Воспроизведение: автоматически при открытии окна
#  gulyaipole_cinematic_intro_window (show_sound = gulyaipole_intro_voiceover)
#
#  ВАЖНО (HOI4 1.19):
#  1. Расширение файла ДОЛЖНО быть `.asset` (не `.sfx`!) — иначе
#     движок не загружает определения.
#  2. Синтаксис в виде голых
#         name = { file = "..." volume = ... }
#     НЕ работает — движок такие блоки игнорирует, и звук в
#     show_sound/hide_sound не находится. Звук должен быть
#     обёрнут в `sound = { ... }` (низкоуровневая запись) либо
#     в `soundeffect = { ... }` (с эффектами 3D).
#  3. Внутри `soundeffect = { sounds = { sound = <name> } }` ссылка
#     на низкоуровневый sound пишется БЕЗ кавычек.
#  4. Атрибут пространственного звука — `is3d` (camelCase), `is_3d`
#     с подчёркиванием НЕ валиден.
#  5. Атрибут `falloff` опционален; если указан, должен ссылаться
#     на существующий falloff-блок. Безопаснее опустить.
# =============================================================================

# -------------------------------------------------------------------------
# 1) Низкоуровневая запись sound. Нужна, чтобы soundeffect мог на
#    неё сослаться по имени. Без кавычек внутри soundeffect.
# -------------------------------------------------------------------------
sound = {
    name = "gulyaipole_intro_voiceover_sound"
    file = "voice.ogg"
    volume = 1.0
    always_load = yes
}

# -------------------------------------------------------------------------
# 2) soundeffect — это то, что ищет show_sound / hide_sound в .gui.
#    Звук привязан к нашему низкоуровневому sound-блоку.
#    `is3d = no` — звук не позиционируется в 3D-пространстве.
#    Имя soundeffect совпадает с тем, что указано в show_sound.
# -------------------------------------------------------------------------
soundeffect = {
    name = "gulyaipole_intro_voiceover"
    sounds = {
        sound = gulyaipole_intro_voiceover_sound
    }
    volume = 1.0
    is3d = no
    max_audible = 1
    max_audible_behaviour = fail
}

# -------------------------------------------------------------------------
# 3) Алиас для совместимости с событием новостей и для обратной совместимости
#    с разными версиями HOI4.
# -------------------------------------------------------------------------
sound = {
    name = "gulyaipole_intro_voice"
    file = "voice.ogg"
    volume = 0.95
    always_load = yes
}

soundeffect = {
    name = "gulyaipole_intro_voice"
    sounds = {
        sound = gulyaipole_intro_voice
    }
    volume = 0.95
    is3d = no
    max_audible = 1
    max_audible_behaviour = fail
}
