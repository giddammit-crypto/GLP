### =========================================================================
###  ГУЛЯЙ-ПОЛЕ — определение белых (инверсных) шрифтов для окон событий.
###
###  Ванильные hoi4_typewriter22 и hoi4_typewriter16 рисуют ЧЁРНЫМ текстом
###  (color = 0xff000000). Мы определяем _inverted-варианты с color = 0xffffffff
###  (белый), ссылающиеся на те же самые .fnt/.tga, что и ваниль.
### =========================================================================

bitmapfonts = {

	### Заголовки событий — белый крупный
	bitmapfont = {
		name = "hoi4_typewriter22_inverted"
		path = "gfx/fonts/hoi4typewriter22"
		color = 0xffffffff
		cursor_offset = { -3 -6 }
		fontsize = 22
	}

	### Описание событий — белый мелкий
	bitmapfont = {
		name = "hoi4_typewriter16_inverted"
		path = "gfx/fonts/hoi4typewriter16"
		color = 0xffffffff
		cursor_offset = { -3 -6 }
		fontsize = 16
	}
}
