spriteTypes = {
    # Тёмная подложка окна — мрачная текстура состаренной бумаги
    spriteType = {
        name = "GFX_intro_bg"
        texturefile = "gfx/interface/intro/gulyaipole_intro_bg.dds"
    }
    spriteType = {
        name = "GFX_tiled_bg_dark"
        texturefile = "gfx/interface/intro/gulyaipole_intro_bg.dds"
    }
    corneredTileSpriteType = {
        name = "GFX_tiled_bg_dark_tiled"
        texturefile = "gfx/interface/intro/gulyaipole_intro_bg.dds"
        borderSize = { x = 0 y = 0 }
        size = { x = 900 y = 700 }
        tilingCenter = no
    }

    # Декоративная золотая кайма — рамка окна 900x700
    spriteType = {
        name = "GFX_gold_inner_border"
        texturefile = "gfx/interface/intro/gulyaipole_gold_inner_border.dds"
        noOfFrames = 1
    }

    # Портрет Нестора Махно для интро — ч/б исторический (156x210 large)
    spriteType = {
        name = "GFX_portrait_nestor_makhno_intro"
        texturefile = "gfx/leaders/GLP/Portrait_GLP_Makhno_Intro_large.dds"
        noOfFrames = 1
    }
    spriteType = {
        name = "GFX_portrait_nestor_makhno_intro_small"
        texturefile = "gfx/leaders/GLP/Portrait_GLP_Makhno_Intro.dds"
        noOfFrames = 1
    }

    # Золотая рамка для портрета (элитная, как у политлидеров)
    spriteType = {
        name = "GFX_political_leader_frame_gold"
        texturefile = "gfx/interface/intro/gulyaipole_portrait_frame_gold.dds"
    }

    # Историческая военная карта Юга Украины (Екатеринославская губерния)
    spriteType = {
        name = "GFX_intro_ukraine_map"
        texturefile = "gfx/interface/intro/gulyaipole_ukraine_map.dds"
    }

    # Сепированная фотокарточка махновской конницы на марше
    spriteType = {
        name = "GFX_intro_makhno_cavalry"
        texturefile = "gfx/interface/intro/gulyaipole_cavalry.dds"
    }

    # Кинематографический автоскролл текста снизу вверх (звёздная сага / титры).
    # base  — полностью прозрачная подложка 310x525 (DXT5), чтобы под иконой
    #         просвечивала архивная фактура окна, а не белый квадрат.
    # mask  — вертикальный альфа-градиент: текст плавно всплывает снизу и
    #         растворяется сверху (DXT5 с альфой).
    # crawl — длинная лента 310x2048 с золотым/кремовым текстом (DXT5).
    # animationrotation = 0.0 задает вертикальное направление скролла
    # (-90.0 в ванили — диагональный блик для иконок фокусов, он крутил
    # текст вбок и был причиной «технических слов» вместо титров).
    spriteType = {
        name = "GFX_intro_text_crawl"
        texturefile = "gfx/interface/intro/gulyaipole_text_base.dds"
        effectFile = "gfx/FX/buttonstate.lua"
        animation = {
            animationmaskfile = "gfx/interface/intro/gulyaipole_text_mask.dds"
            animationtexturefile = "gfx/interface/intro/gulyaipole_text_crawl.dds"
            animationrotation = 0.0
            animationlooping = no
            animationtime = 165.0
            animationdelay = 0.0
            animationblendmode = "add"
            animationtype = "scrolling"
            animationrotationoffset = { x = 0.0 y = 0.0 }
            animationtexturescale = { x = 1.0 y = 1.0 }
        }
        legacy_lazy_load = no
    }

    # Дополнительные вспомогательные спрайты для атмосферы
    spriteType = {
        name = "GFX_intro_vignette_dark"
        texturefile = "gfx/interface/GLP_fallback_texture.dds"
    }
}
