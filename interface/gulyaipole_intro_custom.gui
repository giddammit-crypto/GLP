# =============================================================================
#  ГУЛЯЙ-ПОЛЕ — Кинематографическая заставка (HOI4 v1.19+)
#  AAA Editorial Triptych Layout (1024x768)
#
#  Диегетическая компоновка:
#  - Левая колонка:   Портрет Батьки в барочной золотой рамке + кредо РПА
#  - Центральная:      Архивный свиток с историческим манифестом и скроллом
#  - Правая колонка:  Фотокарточка конницы + аутентичная военная карта штаба
# =============================================================================

guiTypes = {
	containerWindowType = {
		name = "gulyaipole_cinematic_intro_window"
		position = { x = 0 y = 0 }
		size = { width = 1024 height = 768 }
		orientation = center
		origo = center
		moveable = no
		click_to_front = no

		# ── ФОН ОКНА ──────────────────────────────────────────────────────
		background = {
			name = "Background"
			quadTextureSprite = "GFX_intro_bg"
		}

		# Кнопка-крестик в правом верхнем углу
		buttonType = {
			name = "close_intro_button"
			position = { x = 976 y = 14 }
			quadTextureSprite = "GFX_closebutton"
			shortcut = "ESCAPE"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		# ── ВЕРХНИЙ ЗАГОЛОВОК И ДЕВИЗ ─────────────────────────────────────
		instantTextBoxType = {
			name = "intro_title"
