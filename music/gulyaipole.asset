# Гуляй-Поле — регистрация голосовой дорожки как music asset (HOI4 1.19.2).
#
# Файлы *.asset читаются из каталога music/, поэтому voice.ogg лежит рядом
# с этим определением. Для непосредственного запуска заставки используется
# sound_effect = gulyaipole_intro_voice; музыкальная регистрация оставлена
# для радио-совместимости и не подменяет обычный саундтрек игры.

# Имя намеренно отличается от soundeffect gulyaipole_intro_voice:
# событие заставки всегда выбирает именно sound_effect, а не запись радио.
music = {
	name = "gulyaipole_intro_voice_music"
	file = "voice.ogg"
	volume = 1.0
}
