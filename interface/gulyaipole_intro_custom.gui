# Гуляй-Поле — кинематографическая заставка (HOI4 1.19.2)
#
# В окне намеренно оставлен только один containerWindowType.  Все элементы
# находятся в одной координатной системе окна 900x700: это не даёт вложенным
# окнам переопределять origin/position и ломать раскладку.
#
# Голос не запускается из GUI. Событие glp_cinematic_intro.1 вызывает
# sound_effect = gulyaipole_intro_voice, а это окно только отображает флаг.

guiTypes = {
	containerWindowType = {
		name = "gulyaipole_cinematic_intro_window"
		position = { x = 0 y = 0 }
		size = { width = 900 height = 700 }
		orientation = center
		origo = center
		moveable = no
		click_to_front = no
		clipping = yes

		# Мрачная фактура состаренной бумаги из макета. tiledSpriteType даёт
		# цельную подложку любого масштаба без растяжения и без чёрного блока
		# поверх иллюстраций.
		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_bg_dark_tiled"
		}

		# Декоративная рамка имеет прозрачный центр и не участвует в раскладке.
		iconType = {
			name = "intro_window_frame"
			position = { x = 0 y = 0 }
			size = { width = 900 height = 700 }
			spriteType = "GFX_gold_inner_border"
			alwaystransparent = yes
		}

		# Заголовок и подзаголовок — центральная колонка.
		instantTextBoxType = {
			name = "intro_title"
			position = { x = 220 y = 24 }
			font = "hoi_24header"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_INTRO_TITLE"
			maxWidth = 300
			maxHeight = 30
			fixedsize = yes
			format = center
		}

		instantTextBoxType = {
			name = "intro_subtitle"
			position = { x = 220 y = 56 }
			font = "hoi_14mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_INTRO_SUBTITLE"
			maxWidth = 300
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		# Портрет Махно: левый верхний угол окна, без отдельного смещённого
		# контейнера. Сначала портрет, затем рамка — рамка лежит поверх него.
		iconType = {
			name = "makhno_portrait_intro"
			position = { x = 30 y = 30 }
			size = { width = 156 height = 210 }
			spriteType = "GFX_portrait_nestor_makhno_intro"
			alwaystransparent = yes
		}

		iconType = {
			name = "makhno_portrait_frame"
			position = { x = 25 y = 25 }
			size = { width = 166 height = 220 }
			spriteType = "GFX_political_leader_frame_gold"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "makhno_caption"
			position = { x = 30 y = 248 }
			font = "hoi_12mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_MAKHNO_CAPTION"
			maxWidth = 166
			maxHeight = 18
			fixedsize = yes
			format = center
		}

		# Центральный текстовый блок. fixedsize + maxWidth/maxHeight не дают
		# локализации раздвинуть окно или перекрыть правый блок. В отличие от
		# прежней версии здесь нет вложенного containerWindowType.
		instantTextBoxType = {
			name = "cinematic_intro_text"
			position = { x = 220 y = 92 }
			font = "hoi_16mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_EPIC_INTRO_TEXT"
			maxWidth = 300
			maxHeight = 510
			fixedsize = yes
			format = left
		}

		# Правый блок заставки: фотография конницы сверху, военная карта снизу.
		iconType = {
			name = "cavalry_photo"
			position = { x = 550 y = 110 }
			size = { width = 320 height = 160 }
			spriteType = "GFX_intro_makhno_cavalry"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "cavalry_caption"
			position = { x = 550 y = 274 }
			font = "hoi_12mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_CAVALRY_CAPTION"
			maxWidth = 320
			maxHeight = 18
			fixedsize = yes
			format = center
		}

		iconType = {
			name = "ukraine_military_map"
			position = { x = 550 y = 304 }
			size = { width = 320 height = 260 }
			spriteType = "GFX_intro_ukraine_map"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "map_caption"
			position = { x = 550 y = 568 }
			font = "hoi_12mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_MAP_CAPTION"
			maxWidth = 320
			maxHeight = 18
			fixedsize = yes
			format = center
		}

		# Единственная интерактивная кнопка. Клик обрабатывается scripted_gui.
		buttonType = {
			name = "start_campaign_button"
			position = { x = 340 y = 635 }
			quadTextureSprite = "GFX_button_221x34"
			buttonFont = "hoi_18mbs"
			buttonText = "GULYAIPOLE_START_BUTTON"
			shortcut = "ENTER"
			clicksound = click_default
		}
	}
}
