# Гуляй-Поле — кинематографическая заставка (HOI4 1.19.2)
#
# В окне намеренно оставлен только один containerWindowType. Все элементы
# находятся в одной координатной системе окна 900x700: это не даёт вложенным
# окнам переопределять origin/position и ломать раскладку.
#
# Голос запускается событием glp_cinematic_intro.1 (sound_effect + scoped_play_song),
# а окно отображается через scripted GUI по флагу glp_show_cinematic_intro.

guiTypes = {
	containerWindowType = {
		name = "gulyaipole_cinematic_intro_window"
		position = { x = 0 y = 0 }
		size = { width = 900 height = 700 }
		orientation = center
		origo = center
		moveable = no
		click_to_front = no
		clipping = yes

		# Мрачная фактура состаренной архивной бумаги высокого разрешения.
		background = {
			name = "Background"
			quadTextureSprite = "GFX_intro_bg"
		}

		# Декоративная рамка с золотой каймой по внешнему периметру окна
		iconType = {
			name = "intro_window_frame"
			position = { x = 0 y = 0 }
			size = { width = 900 height = 700 }
			spriteType = "GFX_gold_inner_border"
			alwaystransparent = yes
		}

		# Заголовок и подзаголовок — центральная колонка
		instantTextBoxType = {
			name = "intro_title"
			position = { x = 210 y = 24 }
			font = "hoi_24header"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_INTRO_TITLE"
			maxWidth = 320
			maxHeight = 30
			fixedsize = yes
			format = center
		}

		instantTextBoxType = {
			name = "intro_subtitle"
			position = { x = 210 y = 56 }
			font = "hoi_14mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_INTRO_SUBTITLE"
			maxWidth = 320
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		# Портрет Махно: левый верхний угол окна
		iconType = {
			name = "makhno_portrait_intro"
			position = { x = 30 y = 30 }
			size = { width = 156 height = 210 }
			spriteType = "GFX_portrait_nestor_makhno_intro"
			alwaystransparent = yes
		}

		iconType = {
			name = "makhno_portrait_frame"
			position = { x = 25 y = 25 }
			size = { width = 166 height = 220 }
			spriteType = "GFX_political_leader_frame_gold"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "makhno_caption"
			position = { x = 25 y = 248 }
			font = "hoi_12mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_MAKHNO_CAPTION"
			maxWidth = 166
			maxHeight = 18
			fixedsize = yes
			format = center
		}

		# Центральный текстовый блок с плавной вертикальной прокруткой
		instantTextBoxType = {
			name = "cinematic_intro_text"
			position = { x = 215 y = 90 }
			font = "hoi_16mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_EPIC_INTRO_TEXT"
			maxWidth = 310
			maxHeight = 525
			format = left
			scrollbarType = standardtext_slider
		}

		# Правый блок заставки: фотография конницы сверху, военная карта снизу
		iconType = {
			name = "cavalry_photo"
			position = { x = 548 y = 108 }
			size = { width = 320 height = 160 }
			spriteType = "GFX_intro_makhno_cavalry"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "cavalry_caption"
			position = { x = 548 y = 272 }
			font = "hoi_12mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_CAVALRY_CAPTION"
			maxWidth = 320
			maxHeight = 18
			fixedsize = yes
			format = center
		}

		iconType = {
			name = "ukraine_military_map"
			position = { x = 548 y = 302 }
			size = { width = 320 height = 260 }
			spriteType = "GFX_intro_ukraine_map"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "map_caption"
			position = { x = 548 y = 566 }
			font = "hoi_12mbs"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_MAP_CAPTION"
			maxWidth = 320
			maxHeight = 18
			fixedsize = yes
			format = center
		}

		# Интерактивная кнопка начала кампании
		buttonType = {
			name = "start_campaign_button"
			position = { x = 340 y = 635 }
			quadTextureSprite = "GFX_button_221x34"
			buttonFont = "hoi_18mbs"
			buttonText = "GULYAIPOLE_START_BUTTON"
			shortcut = "ENTER"
			clicksound = click_default
		}
	}
}
