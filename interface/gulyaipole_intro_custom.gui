# Гуляй-Поле — кинематографическая заставка (HOI4 1.19.2)
# AAA Оформление и идеальная компоновка (1024x768)

guiTypes = {
	containerWindowType = {
		name = "gulyaipole_cinematic_intro_window"
		position = { x = 0 y = 0 }
		size = { width = 1024 height = 768 }
		orientation = center
		origo = center
		moveable = no
		click_to_front = no

		# ── ФОН И ДЕКОРАТИВНАЯ РАМКА ──────────────────────────────────────
		background = {
			name = "Background"
			quadTextureSprite = "GFX_intro_bg"
		}

		# Рамка убрана — растянутая каёмка портит вид окна

		# Кнопка-крестик в правом верхнем углу
		buttonType = {
			name = "close_intro_button"
			position = { x = 976 y = 14 }
			quadTextureSprite = "GFX_closebutton"
			shortcut = "ESCAPE"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		# ── ВЕРХНИЙ БЛОК: КАРТА, ПОРТРЕТ И КОННИЦА ───────────────────────

		# 1. Левая карточка: Военная карта Екатеринославщины
		iconType = {
			name = "ukraine_military_map"
			position = { x = 45 y = 50 }
			size = { width = 290 height = 230 }
			spriteType = "GFX_intro_ukraine_map"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "map_caption"
			position = { x = 45 y = 286 }
			font = "cg_16b"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_MAP_CAPTION"
			maxWidth = 290
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		# 2. Центральная карточка: Портрет Нестора Махно
		iconType = {
			name = "makhno_portrait_intro"
			position = { x = 417 y = 75 }
			size = { width = 240 height = 310 }
			spriteType = "GFX_portrait_nestor_makhno_intro"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "makhno_caption"
			position = { x = 417 y = 348 }
			font = "cg_16b"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_MAKHNO_CAPTION"
			maxWidth = 240
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		# 3. Правая карточка: Махновская конница
		iconType = {
			name = "cavalry_photo"
			position = { x = 669 y = 60 }
			size = { width = 290 height = 180 }
			spriteType = "GFX_intro_makhno_cavalry"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "cavalry_caption"
			position = { x = 669 y = 246 }
			font = "cg_16b"
			borderSize = { x = 0 y = 0 }
			text = "GULYAIPOLE_CAVALRY_CAPTION"
			maxWidth = 290
			maxHeight = 20
			fixedsize = yes
			format = center
		}

		# ── СРЕДНИЙ БЛОК: ТЕКСТОВАЯ ПАНЕЛЬ ИСТОРИИ ─────────────────────────

		# Тёмная подложка под весь текст на ширину окна (+15px по высоте)
		iconType = {
			name = "text_panel_bg"
			position = { x = 35 y = 375 }
			size = { width = 954 height = 310 }
			spriteType = "GFX_tiled_bg_dark"
			alwaystransparent = yes
		}

		# Текст истории с плавной прокруткой (+15px по высоте)
		instantTextBoxType = {
			name = "cinematic_intro_text"
			position = { x = 50 y = 390 }
			font = "cg_16b"
			borderSize = { x = 4 y = 4 }
			text = "GULYAIPOLE_EPIC_INTRO_TEXT"
			maxWidth = 924
			maxHeight = 280
			format = left
			scrollbarType = standardtext_slider
		}

		# ── НИЖНИЙ БЛОК: КНОПКА ЗАКРЫТИЯ / СТАРТА ──────────────────────────

		# Главная золотая кнопка «Вольному воля!»
		buttonType = {
			name = "start_campaign_button"
			position = { x = 392 y = 696 }
			spriteType = "GFX_intro_start_button"
			buttonText = ""
			clicksound = click_default
			shortcut = "ENTER"
		}

		# Текстовая надпись на кнопке (кириллица cg_16b)
