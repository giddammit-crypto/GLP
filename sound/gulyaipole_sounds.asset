# Гуляй-Поле — звуковая регистрация для HOI4 1.19.2.
# Файл voice.ogg находится в каталоге sound/.

category = {
	name = "Voices"
	soundeffects = {
		gulyaipole_intro_voice
	}
}

sound = {
	name = "gulyaipole_intro_voice_file"
	file = "voice.ogg"
}

soundeffect = {
	name = "gulyaipole_intro_voice"
	sounds = {
		sound = gulyaipole_intro_voice_file
	}
	is3d = no
	max_audible = 1
	max_audible_behaviour = fail
	volume = 0.0
}
