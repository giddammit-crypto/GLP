# ============================================================================
#  GLP tag-specific unit entities
#
#  HOI4 resolves GLP_* entities before falling back to graphical_culture, so
#  only Gulyaypole receives these models.  Weapons, horse and frame are cloned
#  from base-game entities; all imported body meshes are declared separately
#  in GLP_units.gfx.
# ============================================================================

# ------------------------------------------------------------------- Infantry
entity = {
	clone = "infantry_rifle_entity"
	name = "GLP_infantry_entity"
	pdxmesh = "GLP_infantry_rifle_mesh"

	attach = { name = "rifle1" Right_Hand_node = "GER_infantry_weapon_rifle_right_entity" }
	attach = { name = "rifle2" Left_Hand_node  = "GER_infantry_weapon_rifle_left_entity" }
	attach = { name = "rifle3" mid_back_node   = "GER_infantry_weapon_rifle_long_idle_entity" }
	attach = { name = "rifle4" Root_node_2     = "GER_infantry_weapon_rifle_right_entity" }
}

entity = {
	clone = "infantry_2_entity"
	name = "GLP_infantry_2_entity"
	pdxmesh = "GLP_infantry_mg_mesh"

	attach = { name = "rifle1" Right_Hand_node = "GER_infantry_weapon_mg_right_entity" }
	attach = { name = "rifle2" Left_Hand_node  = "GER_infantry_weapon_mg_left_entity" }
	attach = { name = "rifle3" mid_back_node   = "GER_infantry_weapon_mg_long_idle_entity" }
	attach = { name = "rifle4" Root_node_2     = "GER_infantry_weapon_rifle_right_entity" }
}

entity = {
	clone = "GLP_infantry_2_entity"
	name = "GLP_infantry_3_entity"
}

entity = {
	clone = "infantry_rifle_entity"
	name = "GLP_infantry_entity_snow"
	pdxmesh = "GLP_infantry_rifle_mesh_snow"

	attach = { name = "rifle1" Right_Hand_node = "GER_infantry_weapon_rifle_right_entity" }
	attach = { name = "rifle2" Left_Hand_node  = "GER_infantry_weapon_rifle_left_entity" }
	attach = { name = "rifle3" mid_back_node   = "GER_infantry_weapon_rifle_long_idle_entity" }
	attach = { name = "rifle4" Root_node_2     = "GER_infantry_weapon_rifle_right_entity" }
}

entity = {
	clone = "infantry_2_entity"
	name = "GLP_infantry_2_entity_snow"
	pdxmesh = "GLP_infantry_mg_mesh_snow"

	attach = { name = "rifle1" Right_Hand_node = "GER_infantry_weapon_mg_right_entity" }
	attach = { name = "rifle2" Left_Hand_node  = "GER_infantry_weapon_mg_left_entity" }
	attach = { name = "rifle3" mid_back_node   = "GER_infantry_weapon_mg_long_idle_entity" }
	attach = { name = "rifle4" Root_node_2     = "GER_infantry_weapon_rifle_right_entity" }
}

entity = {
	clone = "GLP_infantry_2_entity_snow"
	name = "GLP_infantry_3_entity_snow"
}

# The source pack has no dedicated desert texture.  Keep the GLP model instead
# of falling back to an unrelated eastern-European soldier in desert states.
entity = {
	clone = "GLP_infantry_entity"
	name = "GLP_infantry_entity_desert"
}

entity = {
	clone = "GLP_infantry_2_entity"
	name = "GLP_infantry_2_entity_desert"
}

entity = {
	clone = "GLP_infantry_3_entity"
	name = "GLP_infantry_3_entity_desert"
}

# -------------------------------------------------------------- Sabre entities
entity = {
	name = "GLP_sabre_entity"
	pdxmesh = "GLP_sabre_mesh"
	scale = 1.0
}

entity = {
	name = "GLP_sabre_holder_entity"
	pdxmesh = "GLP_sabre_holder_mesh"
	scale = 1.0
}

# --------------------------------------------------------- Cossack cavalry: rifle
entity = {
	name = "GLP_infantry_rider_entity"
	pdxmesh = "GLP_cavalry_rider_mesh"

	default_state = "idle"
	state = { name = "attack"         animation = "cavalry_attack"      chance = 1 looping = no next_state = "attack" }
	state = { name = "attack"         animation = "cavalry_attack_idle" chance = 4 looping = no next_state = "attack" }
	state = { name = "defend"         animation = "cavalry_attack"      chance = 1 looping = no next_state = "defend" }
	state = { name = "defend"         animation = "cavalry_attack_idle" chance = 4 looping = no next_state = "defend" }
	state = { name = "support_attack" animation = "cavalry_attack"      chance = 1 looping = no next_state = "support_attack" }
	state = { name = "support_attack" animation = "cavalry_attack_idle" chance = 4 looping = no next_state = "support_attack" }
	state = { name = "retreat"        animation = "cavalry_retreat" }
	state = { name = "idle"           animation = "cavalry_idle" }
	state = {
		name = "move"
		animation = "cavalry_move"
		event = { sound = { soundeffect = "horse_walking" } }
	}
	state = { name = "training" animation = "training"      animation_blend_time = 0.3 animation_speed = 1.0 chance = 2 looping = no }
	state = { name = "training" animation = "jumping_jacks" animation_blend_time = 0.3 animation_speed = 1.0 chance = 1 looping = no }
	state = { name = "training" animation = "pushup"        animation_blend_time = 0.3 animation_speed = 1.0 chance = 1 looping = no }

	attach = { name = "sabre"        Right_Hand_node = "GLP_sabre_entity" }
	attach = { name = "sabre_holder" mid_back_node   = "GLP_sabre_holder_entity" }

	scale = 0.9
}

entity = {
	name = "GLP_cavalry_rifle_combined_entity"
	pdxmesh = "infantry_cavalry_horse_mesh"

	default_state = "idle"
	state = { name = "idle"           animation = "cavalry_idle"     animation_blend_time = 0.0 }
	state = { name = "move"           animation = "cavalry_move"     animation_blend_time = 0.0 }
	state = { name = "attack"         animation = "cavalry_attack"   chance = 4 looping = no next_state = "attack" }
	state = { name = "attack"         animation = "cavalry_attack_2" chance = 1 looping = no next_state = "attack" }
	state = { name = "defend"         animation = "cavalry_attack"   chance = 4 looping = no next_state = "defend" }
	state = { name = "defend"         animation = "cavalry_attack_2" chance = 1 looping = no next_state = "defend" }
	state = { name = "support_attack" animation = "cavalry_attack"   chance = 4 looping = no next_state = "support_attack" }
	state = { name = "support_attack" animation = "cavalry_attack_2" chance = 1 looping = no next_state = "support_attack" }
	state = { name = "retreat"        animation = "cavalry_move"     animation_blend_time = 0.0 }
	state = { name = "training"       animation = "cavalry_idle"     animation_blend_time = 0.0 }

	attach = { name = "infantry_unit" Saddle_Node = "GLP_infantry_rider_entity" }
	scale = 0.65
}

entity = {
	clone = "cavalry_entity"
	name = "GLP_cavalry_entity"

	attach = { name = "infantry" infantry = "GLP_infantry_rider_entity" }
	attach = { name = "cavalry" cavalry = "GLP_cavalry_rifle_combined_entity" }
}

# ------------------------------------------------------------- Cossack cavalry: MG
entity = {
	clone = "generic_infantry_mg_rider_entity"
	name = "GLP_infantry_mg_rider_entity"
	pdxmesh = "GLP_cavalry_rider_mg_mesh"

	attach = { name = "rifle1" Right_Hand_node = "GER_infantry_weapon_mg_right_entity" }
	attach = { name = "rifle2" Left_Hand_node  = "GER_infantry_weapon_mg_left_entity" }
	attach = { name = "rifle4" Root_node_2     = "GER_infantry_weapon_rifle_right_entity" }
	scale = 0.9
}

entity = {
	name = "GLP_cavalry_mg_combined_entity"
	pdxmesh = "infantry_cavalry_horse_mesh"

	default_state = "idle"
	state = { name = "idle"           animation = "cavalry_idle" animation_blend_time = 0.0 }
	state = { name = "move"           animation = "cavalry_move" animation_blend_time = 0.0 }
	state = { name = "retreat"        animation = "cavalry_move" animation_blend_time = 0.0 }
	state = { name = "training"       animation = "cavalry_idle" animation_blend_time = 0.0 }
	state = { name = "attack"         animation = "cavalry_idle" animation_blend_time = 0.0 }
	state = { name = "defend"         animation = "cavalry_idle" animation_blend_time = 0.0 }
	state = { name = "support_attack" animation = "cavalry_idle" animation_blend_time = 0.0 }

	attach = { name = "infantry_unit" Saddle_Node = "GLP_infantry_mg_rider_entity" }
	scale = 0.65
}

entity = {
	clone = "cavalry_entity"
	name = "GLP_cavalry_2_entity"

	attach = { name = "infantry" infantry = "GLP_infantry_mg_rider_entity" }
	attach = { name = "cavalry" cavalry = "GLP_cavalry_mg_combined_entity" }
}
