spriteTypes = {
	# =========================================================================
	#  Безопасная сѣтка-заглушка движка.
	#
	#  Ванильный GFX_default_fallback_texture объявленъ въ позднезагружаемомъ
	#  interface.gfx и НЕ доступенъ на этапѣ загрузочнаго экрана. Поэтому
	#  любой «потерянный» спрайтъ во время load_screen превращается въ
	#  фатальную ошибку graphics.cpp:1348 «No [GFX_default_fallback_texture]
	#  defined». Объявляемъ его въ модѣ явно, чтобы движокъ всегда мог
	#  подставить нейтральную полупрозрачную панель вмѣсто краша.
	# =========================================================================
	spriteType = {
		name = "GFX_default_fallback_texture"
		texturefile = "gfx/interface/GLP_fallback_texture.dds"
	}
}
